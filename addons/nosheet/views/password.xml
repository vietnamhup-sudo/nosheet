<odoo>
    <record id="view_password_form" model="ir.ui.view">
        <field name="name">nosheet.password.form</field>
        <field name="model">nosheet.password</field>
        <field name="arch" type="xml">
            <form delete="false" duplicate="false">
                <sheet>
                    <group>
                        <field name="password" password="True"/>
                    </group>
                </sheet>
            <footer>
                <button string="Confirm"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
            </footer>
            </form>
        </field>
    </record>

    <record id="action_nosheet_password" model="ir.actions.act_window">
        <field name="name">Password</field>
        <field name="res_model">nosheet.password</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
