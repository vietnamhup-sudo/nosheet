<odoo>
    <record id="view_product_template_form_inherit_download" model="ir.ui.view">
        <field name="name">product.template.form.inherit.download</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='service_tracking']" position="after">
                <field name="file_data" invisible="type != 'download'"/>
            </xpath>

        </field>
    </record>

</odoo>
