<odoo>
    <record id="view_facebook_page_list" model="ir.ui.view">
        <field name="name">facebook.page.list</field>
        <field name="model">facebook.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="page_id"/>
                <!-- <field name="access_token" password="1"/> -->
                <field name="description"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_facebook_page_form" model="ir.ui.view">
        <field name="name">facebook.page.form</field>
        <field name="model">facebook.page</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <button name="get_page_info"
                        type="object"
                        string="Get Page Info"
                        class="btn-primary"/>
            </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>

                        <group>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="access_token" password="1"/>
                            <field name="page_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Prompt" name="prompt">
                            <field name="prompt" widget="html">
                            </field>
                        </page>
                        <page string="Products" name="product_ids">
                            <field name="product_ids"/>
                        </page>
                        <page string="System Instruction" name="system_instruction" invisible="1">
                            <field name="system_instruction"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_facebook_page_search" model="ir.ui.view">
        <field name="name">facebook.page.search</field>
        <field name="model">facebook.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="is_active"/>
                <field name="page_id"/>
                <field name="access_token"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="action_facebook_page" model="ir.actions.act_window">
        <field name="name">Facebook Page</field>
        <field name="res_model">facebook.page</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_facebook_chatbox"
              name="Facebook Chatbox"
              sequence="1000"/>

    <menuitem id="menu_facebook_page"
              name="Facebook Page"
              parent="menu_facebook_chatbox"
              action="action_facebook_page"
              sequence="1"/>

    <record id="action_fb_chatbox_discuss_channel" model="ir.actions.act_window">
        <field name="name">Livechat Channels</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('channel_type', '=', 'livechat')]</field>
    </record>

    <menuitem id="menu_fb_chatbox_discuss_channel"
              name="Livechats"
              parent="mail.menu_root_discuss"
              action="action_fb_chatbox_discuss_channel"
              sequence="999"/>

</odoo>
